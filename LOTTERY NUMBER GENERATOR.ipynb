        "import random\n",
        "\n",
        "def generate_lottery_numbers():\n",
        "    numbers = random.sample(range(1, 50), 6)\n",
        "\n",
        "    print(\"Your Lottery Numbers are:\")\n",
        "\n",
        "    for num in numbers:\n",
        "        print(num, end=\" \")\n",
        "\n",
        "generate_lottery_numbers()\n"
      ]
    }
